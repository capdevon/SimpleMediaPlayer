MaterialDef MediaPlayer {

    MaterialParameters {
        Texture2D ColorMap             // Main texture map
        Color Color (Color)            // Base tint color
        Float Alpha                    // Global opacity (0.0 to 1.0)
        Float AlphaDiscardThreshold (AlphaTestFallOff) // Threshold for alpha testing
        Boolean EnabledVHS             // Toggle VHS tape dirt effect
        Boolean EnabledLine            // Toggle moving noise strip
        Boolean EnabledGrain           // Toggle dynamic film grain
        Boolean EnabledScanline        // Toggle basic TV scanlines
        Boolean EnabledVignette        // Toggle darkened screen borders
        Boolean EnabledLCD             // Toggle LCD subpixel grid simulation
        Boolean EnabledCRT             // Toggle branchless CRT phosphor mask
        Boolean EnabledGlitch          // Toggle chromatic aberration UV shift
        Boolean EnabledBAW             // Toggle black and white conversion
    }

    Technique {
        VertexShader GLSL300 GLSL150 GLSL100:   MatDefs/SimpleMediaPlayer/SimpleMediaPlayer.vert
        FragmentShader GLSL300 GLSL150 GLSL100: MatDefs/SimpleMediaPlayer/SimpleMediaPlayer.frag

        WorldParameters {
            WorldViewProjectionMatrix
            ViewProjectionMatrix
            ViewMatrix
            Time
            Resolution
        }

        Defines {
            HAS_COLORMAP: ColorMap
            HAS_COLOR: Color
            HAS_ALPHA: Alpha
            DISCARD_ALPHA: AlphaDiscardThreshold
            HAS_EFFECT_VHS: EnabledVHS
            HAS_EFFECT_LINE: EnabledLine
            HAS_EFFECT_GRAIN: EnabledGrain
            HAS_EFFECT_SCANLINE: EnabledScanline
            HAS_EFFECT_VIGNETTE: EnabledVignette
            HAS_EFFECT_LCD: EnabledLCD
            HAS_EFFECT_CRT: EnabledCRT
            HAS_EFFECT_GLITCH: EnabledGlitch
            HAS_EFFECT_BAW: EnabledBAW
        }
    }

    Technique Glow {

        VertexShader GLSL300 GLSL150 GLSL100:   Common/MatDefs/Misc/Unshaded.vert
        FragmentShader GLSL300 GLSL150 GLSL100: Common/MatDefs/Light/Glow.frag

        WorldParameters {
            WorldViewProjectionMatrix
        }

        Defines {
            NEED_TEXCOORD1
        }
    }
}
